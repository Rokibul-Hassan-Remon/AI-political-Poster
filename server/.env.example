# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB Atlas ────────────────────────────────────────
# Atlas → your cluster → Connect → Drivers → copy the string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rise-together?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# Two different secrets, 32+ chars each. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET signs the 15-min access token; JWT_REFRESH_SECRET signs the 7-day refresh cookie.
JWT_SECRET=<long-random-string>
JWT_REFRESH_SECRET=<another-long-random-string>

# ── Seed (optional) ──────────────────────────────────────
# Read only by `npm run seed`. Leave commented out to skip creating the admin user.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=<8-72-chars>

# ── Cloudinary (storage module) ──────────────────────────
# Cloudinary dashboard → "API Environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Gemini (generation module) ───────────────────────────
# aistudio.google.com → Get API key. Verify the model name in AI Studio docs.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
