# Copy to .env and fill in. Never commit .env.

# ── Server ───────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000

# ── MongoDB Atlas ────────────────────────────────────────
# Atlas → your cluster → Connect → Drivers → copy the string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rise-together?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=7d

# ── Cloudinary (storage module) ──────────────────────────
# Cloudinary dashboard → "API Environment variable".
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── Gemini (generation module) ───────────────────────────
# aistudio.google.com → Get API key. Verify the model name in AI Studio docs.
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
